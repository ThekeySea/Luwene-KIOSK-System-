{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/storage/(.*)", "headers": { "cache-control": "public, max-age=604800" } },
    { "src": "/build/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
