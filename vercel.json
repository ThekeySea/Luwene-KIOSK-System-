{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": [
        "vendor/**",
        "app/**",
        "bootstrap/**",
        "config/**",
        "database/**",
        "resources/views/**",
        "routes/**",
        "public/**/*.css",
        "public/**/*.js",
        "public/**/*.svg",
        "public/**/*.png",
        "public/**/*.jpg",
        "public/**/*.ico",
        "public/**/*.woff",
        "public/**/*.woff2",
        "public/**/*.ttf",
        "public/favicon.ico",
        "public/robots.txt",
        "storage/**",
        "cacert.pem"
      ]
    }
  },
  "routes": [
    { "src": "/build/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/storage/(.*)", "headers": { "cache-control": "public, max-age=604800" } },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
